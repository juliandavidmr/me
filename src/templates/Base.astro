---
import '@/styles/global.css';

// eslint-disable-next-line import/no-unresolved
import { ClientRouter } from 'astro:transitions';

import { AppConfig } from '@/utils/AppConfig';

export interface Props {
  head: {
    title: string;
    description: string;
    canonical?: string;
    image?: string;
    keywords?: string;
    lang?: string;
    type?: 'article' | 'profile' | 'website';
  };
}

const {
  head: {
    title,
    description,
    canonical,
    image,
    keywords,
    lang = 'en',
    type = 'website',
  },
} = Astro.props as Props;
const canonicalUrl = canonical ?? Astro.url.href;
const socialImageUrl = image
  ? new URL(image, Astro.site ?? Astro.url).href
  : undefined;
---

<html lang={lang} class="scroll-smooth bg-canvas dark:bg-canvas-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AppConfig.author} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Julian David" />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta
      name="twitter:card"
      content={socialImageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}

    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/icon-light.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/icon-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/icon-light.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body
    class="m-0 bg-canvas font-sans text-sm leading-[1.55] text-ink antialiased dark:bg-canvas-dark dark:text-ink-dark"
  >
    <slot />
  </body>
</html>
