---

---

<section class="max-w-4xl">
  <div class="max-w-3xl">
    <p class="text-2xs font-semibold uppercase tracking-[.2em]">
      Audio tool
      <b class="text-accent">/</b>
    </p>
    <h1
      class="my-6 max-w-2xl text-[clamp(2.75rem,5.4vw,5rem)] font-medium leading-display tracking-display"
    >
      Cortar audio online<i class="not-italic text-accent">.</i>
    </h1>
    <p class="max-w-xl text-xs text-muted dark:text-muted-dark">
      Divide audios largos en partes limpias desde tu navegador. El archivo no
      se sube a ningun servidor.
    </p>
  </div>

  <aside class="mt-8" aria-label="Capacidades de Audio Split">
    <dl class="flex flex-wrap gap-2">
      <div
        class="flex items-center gap-2 border border-line px-3 py-1.5 text-3xs uppercase tracking-label text-muted dark:border-line-dark dark:text-muted-dark"
      >
        <dt>Maximo</dt>
        <dd class="font-medium text-ink dark:text-ink-dark">40 min</dd>
      </div>
      <div
        class="flex items-center gap-2 border border-line px-3 py-1.5 text-3xs uppercase tracking-label text-muted dark:border-line-dark dark:text-muted-dark"
      >
        <dt>Salida</dt>
        <dd class="font-medium text-ink dark:text-ink-dark">WAV + ZIP</dd>
      </div>
      <div
        class="flex items-center gap-2 border border-line px-3 py-1.5 text-3xs uppercase tracking-label text-muted dark:border-line-dark dark:text-muted-dark"
      >
        <dt>Motor</dt>
        <dd class="font-medium text-ink dark:text-ink-dark">PCM local</dd>
      </div>
    </dl>
  </aside>
</section>
