---
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { cn } from '@/utils/cn';
import { sortByDate } from '@/utils/Posts';

const allPosts = Object.values(
  import.meta.glob('./posts/**/*.md', { eager: true }),
);
const lastThreePosts = sortByDate(allPosts).slice(0, 3);
const { title, description } = AppConfig;
const formatDate = (date: string | Date) =>
  new Intl.DateTimeFormat('en-CA', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  })
    .format(new Date(date))
    .replaceAll('-', '.');
const publicPostUrl = (url: string) => url.replace(/^\/posts/, '');
const notes = [
  ['2026.06.09', 'Notes on cognitive load and decision making', '⌁'],
  ['2026.06.07', 'English learning log', '↕'],
  ['2026.06.06', 'Agent orchestration patterns', '⊕'],
  ['2026.06.04', 'Reading: The Pragmatic Programmer', '⋮'],
  ['2026.06.03', 'Ideas for EstampaPaya', '⌜'],
];
const frame =
  'ml-[max(8.4375rem,calc((100%-72.5rem)/2+4.25rem))] w-[min(72.5rem,calc(100%-11.875rem))] max-[56.25rem]:ml-[3.75rem] max-[56.25rem]:w-[calc(100%-5rem)] max-sm:mx-[1.125rem] max-sm:w-[calc(100%-2.25rem)]';
const navLink =
  'relative py-2 text-[.5625rem] font-semibold uppercase tracking-[.18em] after:absolute after:inset-x-0 after:bottom-0 after:h-[0.0625rem] after:origin-center after:scale-x-0 after:bg-[#ff5a1f] after:transition-transform hover:after:scale-x-[.45] max-sm:text-[.5rem] max-sm:tracking-[.1em]';
const heading =
  'mb-6 grid grid-cols-[auto_1fr_auto] items-center gap-7 max-sm:grid-cols-[1fr_auto] max-sm:gap-4';
const headingText =
  'm-0 whitespace-nowrap text-[.625rem] font-semibold uppercase tracking-[.2em]';
---

<Base head={{ title, description }}>
  <header
    class={cn(frame, 'flex h-24 items-center justify-between max-sm:h-20')}
  >
    <a
      class="text-base font-medium tracking-[-.04em] no-underline"
      href="/"
      aria-label="Julian David home"
      ><b class="font-medium text-[#ff5a1f]">/</b> jd</a
    >
    <nav
      class="flex items-center gap-14 max-[56.25rem]:gap-6 max-sm:gap-3"
      aria-label="Primary navigation"
    >
      <a class={cn(navLink, 'after:scale-x-[.45]')} href="/posts/">Writing</a><a
        class={navLink}
        href="/projects/">Projects</a
      ><a class={navLink} href="/notes/">Notes</a><a
        class={navLink}
        href="/about/">About</a
      >
    </nav>
  </header>

  <main>
    <section
      class={cn(
        frame,
        'grid min-h-[29.375rem] grid-cols-[1.4fr_.8fr] items-center max-[56.25rem]:min-h-[26.875rem] max-[56.25rem]:grid-cols-[1fr_.55fr] max-sm:block max-sm:min-h-[35rem] max-sm:pt-16',
      )}
    >
      <h1
        class="my-4 mb-10 text-[clamp(4rem,6.3vw,6rem)] font-medium leading-[.94] tracking-[-.072em] max-[56.25rem]:text-[3.875rem] max-sm:text-[clamp(3.125rem,16vw,4.25rem)]"
      >
        A journal<br /><span class="font-normal tracking-[-.085em]"
          >of ideas,</span
        ><br />systems, and<br /><em
          class="not-italic font-normal tracking-[-.09em]">experiments</em
        ><b class="text-[.5em] text-[#ff5a1f]">.</b>
      </h1>
      <div
        class="mx-auto mt-8 w-56 self-center text-xs tracking-[.04em] text-[#6f6a64] dark:text-[#9a948c] max-sm:mx-0 max-sm:mt-14 max-sm:w-auto"
      >
        <div
          class="relative mb-8 size-[6.875rem] bg-[linear-gradient(#dedbd2,#dedbd2),linear-gradient(90deg,#dedbd2,#dedbd2)] bg-[length:0.0625rem_100%,100%_0.0625rem] bg-center bg-no-repeat dark:bg-[linear-gradient(#2a2926,#2a2926),linear-gradient(90deg,#2a2926,#2a2926)] max-sm:hidden"
          aria-hidden="true"
        >
          <i
            class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 size-1.5 bg-[#ff5a1f]"
          ></i>
        </div>
        <p>
          Thinking in public.<br />Building in public.<br />Learning in public.
        </p><a
          class="mt-3 inline-block text-base text-[#ff5a1f] no-underline"
          href="#recent"
          aria-label="Go to recent writing">↓</a
        >
      </div>
    </section>

    <section class={cn(frame, 'py-10 pb-14 max-sm:py-8')} id="recent">
      <div class={heading}>
        <h2 class={headingText}>Recent <b class="text-[#ff5a1f]">/</b></h2><span
          class="h-[0.0625rem] bg-[#dedbd2] dark:bg-[#2a2926] max-sm:hidden"
        ></span><a
          class={cn(
            headingText,
            'group no-underline max-sm:text-[.5rem] max-sm:tracking-[.1em]',
          )}
          href="/posts/"
          >View all writing <b
            class="ml-5 inline-block transition-transform group-hover:translate-x-1 max-sm:ml-1"
            >→</b
          ></a
        >
      </div>
      <div
        class="border-t border-[#dedbd2] dark:border-[#2a2926] max-sm:border-0"
      >
        {
          lastThreePosts.map((post) => (
            <a
              class="group grid min-h-16 grid-cols-[6.875rem_1.25rem_minmax(17.5rem,1fr)_6.875rem_7.5rem_1.375rem] items-center border-b border-[#dedbd2] no-underline transition-colors hover:bg-[#ff5a1f]/[.025] dark:border-[#2a2926] max-[56.25rem]:grid-cols-[5.9375rem_1.125rem_1fr_5.625rem_1.375rem] max-sm:relative max-sm:flex max-sm:min-h-24 max-sm:flex-wrap max-sm:gap-x-3 max-sm:gap-y-1 max-sm:py-4 max-sm:pr-5"
              href={publicPostUrl(post.url)}
            >
              <time class="text-[.5625rem] uppercase tracking-[.08em] text-[#6f6a64] [font-variant-numeric:tabular-nums] dark:text-[#9a948c]">
                {formatDate(post.frontmatter.pubDate)}
              </time>
              <i class="size-1.5 rounded-full bg-[#ff5a1f] transition-shadow group-hover:shadow-[0_0_0_0.25rem_rgba(255,90,31,.16)] max-sm:absolute max-sm:right-1 max-sm:top-6" />
              <strong class="text-lg font-medium tracking-[-.035em] transition-transform group-hover:translate-x-1 max-sm:order-2 max-sm:w-full max-sm:text-base">
                {post.frontmatter.title.trim()}
              </strong>
              <span class="text-[.5625rem] uppercase tracking-[.08em] text-[#6f6a64] dark:text-[#9a948c] max-sm:order-3">
                Writing
              </span>
              <span class="text-[.5625rem] uppercase tracking-[.08em] text-[#6f6a64] dark:text-[#9a948c] max-[56.25rem]:hidden">
                {post.frontmatter.tags?.slice(0, 2).join(', ') || 'Journal'}
              </span>
              <b class="font-normal transition-transform group-hover:translate-x-1 max-sm:absolute max-sm:bottom-5 max-sm:right-0">
                →
              </b>
            </a>
          ))
        }
      </div>
    </section>

    <section class={cn(frame, 'py-10 pb-14 max-sm:py-8')} id="projects">
      <div class={heading}>
        <h2 class={headingText}>
          Projects <b class="text-[#ff5a1f]">/</b>
        </h2><span
          class="h-[0.0625rem] bg-[#dedbd2] dark:bg-[#2a2926] max-sm:hidden"
        ></span><a
          class={cn(
            headingText,
            'group no-underline max-sm:text-[.5rem] max-sm:tracking-[.1em]',
          )}
          href="/projects/"
          >View all projects <b
            class="ml-5 inline-block transition-transform group-hover:translate-x-1 max-sm:ml-1"
            >→</b
          ></a
        >
      </div>
      <div>
        {
          [
            [
              '01',
              'EstampaPaya',
              'Design personalized products in 3D',
              'before requesting a quote.',
              '2026.06.10',
              '/assets/journal/estampapaya.png',
              'text-[#0d0d0d] border-[#dedbd2]',
              '/2026/04/estampapaya-disenar-productos-personalizados-3d/',
            ],
          ].map(([index, name, line1, line2, date, image, color, href]) => (
            <a
              class={cn(
                'group relative isolate flex min-h-96 flex-col justify-between overflow-hidden border p-7 no-underline hover:border-[#ff5a1f]/60 max-sm:min-h-80',
                color,
              )}
              href={href}
            >
              <img
                class="absolute inset-0 -z-10 size-full object-cover transition duration-[600ms] group-hover:scale-[1.018] group-hover:opacity-90"
                src={image}
                alt=""
              />
              <>
                <small class="text-[.625rem] font-semibold">{index}</small>
                <div>
                  <>
                    <h3 class="mb-[.5625rem] mt-[5.625rem] text-[2.3125rem] font-medium tracking-[-.06em]">
                      {name}
                    </h3>
                    <p class="m-0 text-xs tracking-[.02em]">
                      {line1}
                      <br />
                      {line2}
                    </p>
                  </>
                </div>
              </>
              <footer class="flex items-end justify-between text-[.5625rem] uppercase tracking-[.09em] text-[#6f6a64] [font-variant-numeric:tabular-nums] dark:text-[#9a948c]">
                <>
                  <span>
                    Last update
                    <>
                      <br />
                      <b class="font-medium">{date}</b>
                    </>
                  </span>
                  <b class="font-medium transition-transform group-hover:translate-x-1">
                    →
                  </b>
                </>
              </footer>
            </a>
          ))
        }
      </div>
    </section>

    <section class={cn(frame, 'py-10 pb-14 max-sm:py-8')} id="notes">
      <div class={heading}>
        <h2 class={headingText}>
          Latest notes <b class="text-[#ff5a1f]">/</b>
        </h2><span
          class="h-[0.0625rem] bg-[#dedbd2] dark:bg-[#2a2926] max-sm:hidden"
        ></span><a
          class={cn(
            headingText,
            'group no-underline max-sm:text-[.5rem] max-sm:tracking-[.1em]',
          )}
          href="/notes/"
          >View all notes <b
            class="ml-5 inline-block transition-transform group-hover:translate-x-1 max-sm:ml-1"
            >→</b
          ></a
        >
      </div>
      <div
        class="grid grid-cols-5 border-y border-[#dedbd2] dark:border-[#2a2926] max-[56.25rem]:grid-cols-3 max-sm:block max-sm:border-b-0"
      >
        {
          notes.map(([date, noteTitle, mark]) => (
            <a
              class="grid min-h-48 grid-rows-[2.875rem_auto_1fr] border-r border-[#dedbd2] px-5 py-6 no-underline transition-colors last:border-r-0 hover:bg-[#ff5a1f]/[.025] dark:border-[#2a2926] max-[56.25rem]:[&:nth-child(3)]:border-r-0 max-sm:grid-cols-[2.8125rem_5.625rem_1fr] max-sm:grid-rows-1 max-sm:items-center max-sm:border-b max-sm:border-r-0 max-sm:px-0 max-sm:py-4"
              href="#notes"
            >
              <>
                <i class="text-lg not-italic max-sm:h-auto">{mark}</i>
                <time class="text-[.5625rem] tracking-[.08em] text-[#6f6a64] [font-variant-numeric:tabular-nums] dark:text-[#9a948c]">
                  {date}
                </time>
                <strong class="mt-4 text-xs font-medium leading-[1.65] max-sm:m-0">
                  {noteTitle}
                </strong>
              </>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <footer
    class="mt-14 border-t border-[#dedbd2] dark:border-[#2a2926]"
    id="about"
  >
    <div
      class={cn(
        frame,
        'grid min-h-72 grid-cols-[.85fr_1.65fr_1fr] max-[56.25rem]:grid-cols-[1fr_1.3fr] max-sm:block',
      )}
    >
      <div
        class="min-w-0 border-r border-[#dedbd2] px-7 py-8 dark:border-[#2a2926] max-sm:border-b max-sm:border-r-0 max-sm:px-0 max-sm:py-8"
      >
        <b class="font-medium text-[#ff5a1f]">/</b><p
          class="text-xs leading-[1.65] text-[#6f6a64] dark:text-[#9a948c]"
        >
          This is my journal.<br />I write to think clearly.<br />I build to
          understand.<br />I share to connect.
        </p><div class="mt-7 flex gap-4">
          {
            [
              ['GH', 'https://github.com/anlijudavid'],
              ['X', 'https://x.com/'],
              ['IN', 'https://linkedin.com/'],
              ['RSS', '/rss.xml'],
              ['@', 'mailto:hello@iamjuliand.com'],
            ].map(([label, url]) => (
              <a
                class="text-[.5625rem] font-semibold text-[#6f6a64] no-underline dark:text-[#9a948c]"
                href={url}
              >
                {label}
              </a>
            ))
          }
        </div>
      </div>
      <img
        class="size-full min-w-0 border-r border-[#dedbd2] object-cover grayscale dark:border-[#2a2926] dark:opacity-80 dark:invert max-[56.25rem]:hidden"
        src="/assets/journal/footer-topography.png"
        alt="Abstract ink topographic landscape"
      />
      <div
        class="flex min-w-0 flex-col justify-center px-7 py-8 max-sm:min-h-[15rem] max-sm:border-b-0 max-sm:px-0 max-sm:py-8"
      >
        <h2
          class="mb-3 max-w-xs text-base font-medium leading-[1.15] tracking-[-.03em]"
        >
          Subscribe to my Newsletters
        </h2><p
          class="text-xs leading-[1.65] text-[#6f6a64] dark:text-[#9a948c]"
        >
          Occasional updates on new posts and projects.
        </p><form
          class="mt-5 flex border-b border-[#0d0d0d] dark:border-[#f4f1ea]"
          action="mailto:hello@iamjuliand.com"
          method="post"
        >
          <label class="sr-only" for="email">Email address</label><input
            class="w-full border-0 bg-transparent py-2.5 text-[.5625rem] tracking-[.06em] outline-0"
            id="email"
            type="email"
            name="email"
            placeholder="YOUR@EMAIL.COM"
            required
          /><button
            class="cursor-pointer border-0 bg-transparent transition hover:translate-x-1 hover:text-[#ff5a1f]"
            type="submit"
            aria-label="Subscribe">→</button
          >
        </form>
      </div>
    </div>
    <div
      class={cn(
        frame,
        'flex h-16 items-center justify-between border-t border-[#dedbd2] text-[.5rem] uppercase tracking-[.1em] text-[#6f6a64] dark:border-[#2a2926] dark:text-[#9a948c]',
      )}
    >
      <span>© 2026 Julian David</span><a class="no-underline" href="#">Top ↑</a>
    </div>
  </footer>
</Base>
