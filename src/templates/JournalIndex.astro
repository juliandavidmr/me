---
import { frame, Navbar } from '@/partials/Navbar';
import Base from '@/templates/Base.astro';
import { cn } from '@/utils/cn';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: { date: string; title: string; meta: string; href?: string }[];
}

const { eyebrow, title, description, items } = Astro.props as Props;
let active: 'projects' | 'about' | undefined;
if (eyebrow === 'Projects') active = 'projects';
if (eyebrow === 'About') active = 'about';
---

<Base head={{ title: `${title} — Julian David`, description }}>
  <Navbar active={active} />
  <main class={cn(frame, 'min-h-[calc(100vh-6rem)] py-24 max-sm:pt-16')}>
    <p class="text-2xs font-semibold uppercase tracking-[.2em]">
      {eyebrow}
      <b class="text-accent">/</b>
    </p>
    <h1
      class="my-8 mb-5 max-w-3xl text-[clamp(3.625rem,7vw,6.375rem)] font-medium leading-display tracking-display"
    >
      <span>{title}</span><i class="not-italic text-accent">.</i>
    </h1>
    <p class="mb-20 max-w-lg text-xs text-muted dark:text-muted-dark">
      {description}
    </p>
    <div class="border-t border-line dark:border-line-dark">
      {
        items.map((item) => (
          <a
            class="group grid min-h-20 grid-cols-[8.125rem_1fr_12.5rem_1.25rem] items-center border-b border-line no-underline transition-colors hover:bg-accent/2.5 dark:border-line-dark max-sm:grid-cols-[1fr_1.25rem] max-sm:gap-2 max-sm:py-4"
            href={item.href || '/'}
          >
            <time class="text-3xs uppercase tracking-label text-muted [font-variant-numeric:tabular-nums] dark:text-muted-dark">
              {item.date}
            </time>
            <strong class="text-base font-medium transition-transform group-hover:translate-x-1 max-sm:col-start-1 max-sm:text-base">
              {item.title}
            </strong>
            <span class="text-3xs uppercase tracking-label text-muted dark:text-muted-dark max-sm:col-start-1">
              {item.meta}
            </span>
            <b class="font-normal max-sm:col-start-2 max-sm:row-span-3 max-sm:row-start-1">
              →
            </b>
          </a>
        ))
      }
    </div>
    <a
      class="mt-12 inline-block text-3xs uppercase tracking-[.12em] text-muted no-underline dark:text-muted-dark"
      href="/">← Return to journal</a
    >
  </main>
</Base>
