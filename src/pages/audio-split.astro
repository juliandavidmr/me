---
import AudioSplitHero from '@/components/audio-split/AudioSplitHero.astro';
import AudioSplitStructuredData from '@/components/audio-split/AudioSplitStructuredData.astro';
import AudioSplitTool from '@/components/audio-split/AudioSplitTool.astro';
import { frame, Navbar } from '@/partials/Navbar';
import Base from '@/templates/Base.astro';
import { cn } from '@/utils/cn';

const title = 'Audio Split — Cortar audio online gratis';
const description =
  'Divide audios largos en segmentos descargables desde el navegador, con duracion configurable, deteccion opcional de silencios y descarga ZIP.';
const canonical = new URL('/audio-split/', Astro.site ?? Astro.url).href;
const keywords = [
  'cortar audio online',
  'dividir audio',
  'separar audio en partes',
  'audio splitter',
  'split audio online',
  'detectar silencios audio',
  'cortar mp3 online',
  'cortar m4a online',
  'herramienta audio navegador',
  'separa audio para ElevenLabs',
].join(', ');
---

<Base head={{ title, description, canonical, keywords, lang: 'es' }}>
  <Navbar />
  <main
    class={cn(frame, 'min-h-[calc(100vh-6rem)] pb-20 pt-16 max-sm:pt-8')}
    transition:name="audio-split-page"
  >
    <AudioSplitHero />
    <AudioSplitTool />
  </main>

  <AudioSplitStructuredData canonical={canonical} description={description} />
</Base>
