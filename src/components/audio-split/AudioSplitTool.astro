---

---

<section
  id="audio-tool"
  class="mt-12 grid grid-cols-[minmax(20rem,26rem)_1fr] gap-12 border-t border-line pt-10 dark:border-line-dark max-tablet:grid-cols-1"
>
  <form id="split-form" class="grid content-start gap-7">
    <label
      class="group grid min-h-64 cursor-pointer border border-ink bg-ink/[.025] p-6 transition-colors hover:border-accent hover:bg-accent/[.045] dark:border-ink-dark dark:bg-ink-dark/[.035]"
    >
      <input
        id="audio-file"
        class="sr-only"
        type="file"
        accept="audio/*,.m4a,audio/mp4,audio/x-m4a"
      />
      <span class="flex h-full flex-col justify-between">
        <span
          class="flex items-center justify-between text-3xs font-semibold uppercase tracking-label text-muted dark:text-muted-dark"
        >
          <span>Paso 01</span>
          <span>Archivo local</span>
        </span>
        <span>
          <span class="block text-card-title font-medium tracking-card-title">
            Seleccionar audio
          </span>
          <span
            class="mt-4 block max-w-72 text-xs text-muted dark:text-muted-dark"
          >
            Empieza aqui. Elige un archivo para calcular la duracion y activar
            el procesamiento.
          </span>
        </span>
        <span
          id="file-label"
          class="block border-t border-line pt-4 text-3xs uppercase tracking-label text-muted dark:border-line-dark dark:text-muted-dark"
        >
          MP3, M4A, WAV, AAC u OGG
        </span>
      </span>
    </label>

    <div class="grid gap-5 border-y border-line py-6 dark:border-line-dark">
      <label class="grid gap-2">
        <span
          class="text-3xs font-semibold uppercase tracking-label text-muted dark:text-muted-dark"
        >
          Duracion por segmento
        </span>
        <span class="flex items-center gap-3">
          <input
            id="segment-minutes"
            class="min-w-0 flex-1 border border-line bg-transparent px-3 py-2 text-base outline-none focus:border-accent dark:border-line-dark"
            type="number"
            min="1"
            max="40"
            step="1"
            value="5"
          />
          <span class="text-xs text-muted dark:text-muted-dark">min</span>
        </span>
      </label>

      <label class="flex items-center justify-between gap-6">
        <span>
          <span
            class="block text-3xs font-semibold uppercase tracking-label text-muted dark:text-muted-dark"
          >
            Deteccion de silencios
          </span>
          <span class="mt-1 block text-xs text-muted dark:text-muted-dark">
            Buscar cortes naturales
          </span>
        </span>
        <input
          id="silence-enabled"
          class="h-5 w-10 accent-accent"
          type="checkbox"
          checked
        />
      </label>
    </div>

    <button
      id="split-button"
      class="min-h-12 border border-ink bg-ink px-5 text-3xs font-semibold uppercase tracking-nav text-canvas transition-colors hover:bg-accent hover:text-ink disabled:cursor-not-allowed disabled:border-line disabled:bg-transparent disabled:text-muted dark:border-ink-dark dark:bg-ink-dark dark:text-canvas-dark dark:disabled:border-line-dark dark:disabled:bg-transparent dark:disabled:text-muted-dark valid:cursor-pointer"
      type="submit"
      disabled
    >
      Dividir audio
    </button>
    <p
      id="split-hint"
      class="-mt-3 text-xs text-muted dark:text-muted-dark"
      aria-live="polite"
    >
      Se dividira el audio en partes de 5 minutos.
    </p>
  </form>

  <div class="grid content-start gap-8">
    <div class="border-y border-line py-6 dark:border-line-dark">
      <div
        class="flex items-center justify-between gap-5 text-3xs uppercase tracking-label text-muted dark:text-muted-dark"
      >
        <span id="status-label">Esperando archivo</span>
        <span id="progress-value">0%</span>
      </div>
      <div class="mt-4 h-1.5 bg-line dark:bg-line-dark">
        <div
          id="progress-bar"
          class="h-full w-0 bg-accent transition-[width] duration-300"
        >
        </div>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-5 max-sm:grid-cols-1">
      <div class="border-b border-line pb-4 dark:border-line-dark">
        <p
          class="text-3xs uppercase tracking-label text-muted dark:text-muted-dark"
        >
          Duracion
        </p>
        <strong
          id="duration-stat"
          class="mt-2 block text-card-title font-medium tracking-card-title"
          >--</strong
        >
      </div>
      <div class="border-b border-line pb-4 dark:border-line-dark">
        <p
          class="text-3xs uppercase tracking-label text-muted dark:text-muted-dark"
        >
          Segmentos
        </p>
        <strong
          id="segments-stat"
          class="mt-2 block text-card-title font-medium tracking-card-title"
          >0</strong
        >
      </div>
      <div class="border-b border-line pb-4 dark:border-line-dark">
        <p
          class="text-3xs uppercase tracking-label text-muted dark:text-muted-dark"
        >
          Tamano
        </p>
        <strong
          id="size-stat"
          class="mt-2 block text-card-title font-medium tracking-card-title"
          >--</strong
        >
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="text-prose-h4 font-medium tracking-title">
        Segmentos generados
      </h2>
      <button
        id="download-all"
        class="border border-line px-4 py-2 text-3xs font-semibold uppercase tracking-nav transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:text-muted dark:border-line-dark dark:disabled:text-muted-dark"
        type="button"
        disabled
      >
        Descargar ZIP
      </button>
    </div>

    <ol id="segments-list" class="grid gap-3"></ol>
  </div>
</section>

<script>
  import '@/scripts/audio-split';
</script>
