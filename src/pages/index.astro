---
import { Footer } from '@/partials/Footer';
import { frame, Navbar } from '@/partials/Navbar';
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { cn } from '@/utils/cn';
import { games } from '@/utils/Games';
import { sortByDate } from '@/utils/Posts';

const allPosts = Object.values(
  import.meta.glob('./posts/**/*.md', { eager: true }),
);
const latestPosts = sortByDate(allPosts).slice(0, 7);
const { title, description } = AppConfig;
const formatDate = (date: string | Date) =>
  new Intl.DateTimeFormat('en-CA', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  })
    .format(new Date(date))
    .replaceAll('-', '.');
const publicPostUrl = (url: string) => url.replace(/^\/posts/, '');
const heading =
  'mb-6 grid grid-cols-[auto_1fr_auto] items-center gap-7 max-sm:grid-cols-[1fr_auto] max-sm:gap-4';
const headingText =
  'm-0 whitespace-nowrap text-2xs font-semibold uppercase tracking-[.2em]';
---

<Base head={{ title, description }}>
  <Navbar />

  <main>
    <section
      class={cn(
        frame,
        'grid min-h-117.5 grid-cols-[1.4fr_.8fr] items-center max-tablet:min-h-107.5 max-tablet:grid-cols-[1fr_.55fr] max-sm:block max-sm:min-h-140 max-sm:pt-16',
      )}
    >
      <h1
        class="kinetic-title"
        data-kinetic-title
        aria-label="Julian D. thinks, builds, and writes here."
      >
        <span class="kinetic-line" data-text="Julian D." tabindex="0"
          >Julian D.</span
        >
        <span
          class="kinetic-line font-normal tracking-[-.085em]"
          data-text="thinks, builds,"
          tabindex="0">thinks, builds,</span
        >
        <span class="kinetic-line" data-text="and writes" tabindex="0"
          >and writes</span
        >
        <span
          class="kinetic-line font-normal tracking-[-.09em]"
          data-text="here."
          tabindex="0"
        >
          <em class="not-italic">here</em><b class="text-[.5em] text-accent">
            .
          </b>
        </span>
      </h1>
      <div
        class="mx-auto mt-8 w-56 self-center text-xs -tracking-brand text-muted dark:text-muted-dark max-sm:mx-0 max-sm:mt-14 max-sm:w-auto"
      >
        <div
          class="relative mb-8 size-27.5 bg-[linear-gradient(#dedbd2,#dedbd2),linear-gradient(90deg,#dedbd2,#dedbd2)] bg-size-[0.0625rem_100%,100%_0.0625rem] bg-center bg-no-repeat dark:bg-[linear-gradient(#2a2926,#2a2926),linear-gradient(90deg,#2a2926,#2a2926)] max-sm:hidden"
          aria-hidden="true"
        >
          <i
            class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 size-1.5 bg-accent"
          ></i>
        </div>
        <p>
          Thinking in public.<br />Building in public.<br />Learning in public.
        </p><a
          class="mt-3 inline-block text-base text-accent no-underline"
          href="#recent"
          aria-label="Go to recent writing">↓</a
        >
      </div>
    </section>

    <section class={cn(frame, 'py-10 pb-14 max-sm:py-8')} id="recent">
      <div class={heading}>
        <h2 class={headingText}>Recent <b class="text-accent">/</b></h2><span
          class="h-px bg-line dark:bg-line-dark max-sm:hidden"></span><a
          class={cn(
            headingText,
            'group no-underline max-sm:text-4xs max-sm:tracking-wide-label',
          )}
          href="/posts/"
          >View all writing <b
            class="ml-5 inline-block transition-transform group-hover:translate-x-1 max-sm:ml-1"
            >→</b
          ></a
        >
      </div>
      <div class="border-t border-line dark:border-line-dark max-sm:border-0">
        {
          latestPosts.map((post) => (
            <a
              class="group grid min-h-16 grid-cols-[6.875rem_1.25rem_minmax(17.5rem,1fr)_6.875rem_7.5rem_1.375rem] items-center border-b border-line no-underline transition-colors hover:bg-accent/[.025] dark:border-line-dark max-tablet:grid-cols-[5.9375rem_1.125rem_1fr_5.625rem_1.375rem] max-sm:relative max-sm:flex max-sm:min-h-24 max-sm:flex-wrap max-sm:gap-x-3 max-sm:gap-y-1 max-sm:py-4 max-sm:pr-5"
              href={publicPostUrl(post.url)}
            >
              <time class="text-3xs uppercase tracking-label text-muted [font-variant-numeric:tabular-nums] dark:text-muted-dark">
                {formatDate(post.frontmatter.pubDate)}
              </time>
              <i class="size-1.5 rounded-full bg-accent transition-shadow group-hover:shadow-[0_0_0_0.25rem_rgba(255,90,31,.16)] max-sm:absolute max-sm:right-1 max-sm:top-6" />
              <strong class="text-lg font-medium tracking-title transition-transform group-hover:translate-x-1 max-sm:order-2 max-sm:w-full max-sm:text-base">
                {post.frontmatter.title.trim()}
              </strong>
              <span class="text-3xs uppercase tracking-label text-muted dark:text-muted-dark max-sm:order-3">
                Writing
              </span>
              <span class="text-3xs uppercase tracking-label text-muted dark:text-muted-dark max-tablet:hidden">
                {post.frontmatter.tags?.slice(0, 2).join(', ') || 'Journal'}
              </span>
              <b class="font-normal transition-transform group-hover:translate-x-1 max-sm:absolute max-sm:bottom-5 max-sm:right-0">
                →
              </b>
            </a>
          ))
        }
      </div>
    </section>

    <section class={cn(frame, 'py-10 pb-14 max-sm:py-8')} id="projects">
      <div class={heading}>
        <h2 class={headingText}>
          Projects <b class="text-accent">/</b>
        </h2><span class="h-px bg-line dark:bg-line-dark max-sm:hidden"
        ></span><a
          class={cn(
            headingText,
            'group no-underline max-sm:text-4xs max-sm:tracking-wide-label',
          )}
          href="/projects/"
          >View all projects <b
            class="ml-5 inline-block transition-transform group-hover:translate-x-1 max-sm:ml-1"
            >→</b
          ></a
        >
      </div>
      <div>
        {
          [
            [
              '01',
              'Audio Split',
              'Split long audio locally',
              'with silence-aware cuts.',
              '2026.06.21',
              '/assets/images/project-web-design.png',
              'text-ink border-line',
              '/audio-split/',
            ],
            [
              '02',
              'EstampaPaya',
              'Design personalized products in 3D',
              'before requesting a quote.',
              '2026.06.10',
              '/assets/journal/estampapaya.png',
              'text-ink border-line',
              '/2026/04/estampapaya-disenar-productos-personalizados-3d/',
            ],
          ].map(([index, name, line1, line2, date, image, color, href]) => (
            <a
              class={cn(
                'group relative isolate flex min-h-96 flex-col justify-between overflow-hidden border p-7 no-underline hover:border-accent/60 max-sm:min-h-80',
                color,
              )}
              href={href}
            >
              <img
                class="absolute inset-0 -z-10 size-full object-cover transition duration-600 group-hover:scale-[1.018] group-hover:opacity-90"
                src={image}
                alt=""
              />
              <>
                <small class="text-2xs font-semibold">{index}</small>
                <div>
                  <>
                    <h3 class="mb-2.25 mt-22.5 text-card-title font-medium tracking-[-.06em]">
                      {name}
                    </h3>
                    <p class="m-0 text-xs tracking-[.02em]">
                      {line1}
                      <br />
                      {line2}
                    </p>
                  </>
                </div>
              </>
              <footer class="flex items-end justify-between text-3xs uppercase tracking-[.09em] text-muted [font-variant-numeric:tabular-nums] dark:text-muted-dark">
                <>
                  <span>
                    Last update
                    <>
                      <br />
                      <b class="font-medium">{date}</b>
                    </>
                  </span>
                  <b class="font-medium transition-transform group-hover:translate-x-1">
                    →
                  </b>
                </>
              </footer>
            </a>
          ))
        }
      </div>
    </section>

    <section class={cn(frame, 'py-10 pb-20 max-sm:py-8')} id="games">
      <div class={heading}>
        <h2 class={headingText}>
          Games <b class="text-accent">/</b>
        </h2><span class="h-px bg-line dark:bg-line-dark max-sm:hidden"
        ></span><a
          class={cn(
            headingText,
            'group no-underline max-sm:text-4xs max-sm:tracking-wide-label',
          )}
          href="/games/"
          >View all games <b
            class="ml-5 inline-block transition-transform group-hover:translate-x-1 max-sm:ml-1"
            >→</b
          ></a
        >
      </div>
      <div class="border-t border-line dark:border-line-dark max-sm:border-0">
        {
          games.map((game) => (
            <a
              class="group grid min-h-20 grid-cols-[7.5rem_minmax(12rem,1fr)_12.5rem_1.375rem] items-center border-b border-line no-underline transition-colors hover:bg-accent/2.5 dark:border-line-dark max-sm:relative max-sm:flex max-sm:min-h-24 max-sm:flex-wrap max-sm:gap-x-3 max-sm:gap-y-1 max-sm:py-4 max-sm:pr-5"
              href={game.href}
            >
              <time class="text-3xs uppercase tracking-label text-muted [font-variant-numeric:tabular-nums] dark:text-muted-dark">
                {game.date}
              </time>
              <span>
                <strong class="block text-lg font-medium tracking-title transition-transform group-hover:translate-x-1 max-sm:text-base">
                  {game.title}
                </strong>
                <span class="mt-1 block text-xs text-muted dark:text-muted-dark">
                  {game.description}
                </span>
              </span>
              <span class="text-3xs uppercase tracking-label text-muted dark:text-muted-dark">
                {game.meta}
              </span>
              <b class="font-normal transition-transform group-hover:translate-x-1 max-sm:absolute max-sm:bottom-5 max-sm:right-0">
                →
              </b>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const titles = document.querySelectorAll<HTMLElement>('[data-kinetic-title]');

  titles.forEach((title) => {
    const updateTilt = (event: PointerEvent) => {
      const rect = title.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;

      title.style.setProperty('--tilt-x', `${y * -8}deg`);
      title.style.setProperty('--tilt-y', `${x * 10}deg`);
      title.style.setProperty('--light-x', `${(x + 0.5) * 100}%`);
      title.style.setProperty('--light-y', `${(y + 0.5) * 100}%`);
    };

    const resetTilt = () => {
      title.style.removeProperty('--tilt-x');
      title.style.removeProperty('--tilt-y');
      title.style.removeProperty('--light-x');
      title.style.removeProperty('--light-y');
    };

    title.addEventListener('pointermove', updateTilt);
    title.addEventListener('pointerleave', resetTilt);
  });
</script>
