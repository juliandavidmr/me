---
import type {
  IFrontmatter,
  MarkdownInstance,
} from 'astro-boilerplate-components';

import Comments from '@/partials/Comments.astro';
import { Navbar } from '@/partials/Navbar';
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { cn } from '@/utils/cn';
import { sortByDate } from '@/utils/Posts';

interface ArticleFrontmatter extends IFrontmatter {
  updatedDate?: string;
  author?: string;
  tags?: string[];
  images?: string[];
  imgSrc?: string;
  imgAlt?: string;
  heroLayout?: 'normal' | 'wide' | 'full' | 'bleed' | 'screen';
}
export interface Props {
  content: ArticleFrontmatter;
}
const { content } = Astro.props as Props;
const articleTitle = content.title.trim();
const title = `${articleTitle} — ${AppConfig.site_name}`;
const allPosts = sortByDate(
  Object.values(
    import.meta.glob<MarkdownInstance<IFrontmatter>>('../pages/posts/**/*.md', {
      eager: true,
    }),
  ),
);
const currentIndex = allPosts.findIndex(
  (post) =>
    post.frontmatter.title === content.title &&
    String(post.frontmatter.pubDate) === String(content.pubDate),
);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const olderPost =
  currentIndex >= 0 && currentIndex < allPosts.length - 1
    ? allPosts[currentIndex + 1]
    : undefined;
const heroImage = content.imgSrc || content.images?.[0];
const updated = content.updatedDate || content.pubDate;
const author = content.author || AppConfig.author;
const formatDate = (date: string | Date) =>
  new Intl.DateTimeFormat('en-CA', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  })
    .format(new Date(date))
    .replaceAll('-', '.');
const publicPostUrl = (post?: MarkdownInstance<IFrontmatter>) =>
  post?.url?.replace(/^\/posts/, '') || '/posts/';
const heroWidths = {
  normal: 'w-[min(40rem,calc(100%-3rem))] max-sm:w-[calc(100%-2.25rem)]',
  wide: 'w-[min(57.5rem,calc(100%-3rem))] max-sm:w-[calc(100%-2.25rem)]',
  full: 'w-[min(72.5rem,calc(100%-3rem))] max-sm:w-[calc(100%-2.25rem)]',
  bleed: 'w-[calc(100%-3rem)] max-sm:w-full',
  screen: 'w-full [&_img]:h-[calc(100vh-5.5rem)] [&_img]:max-h-none',
};
const prose = cn(
  'prose prose-neutral dark:prose-invert mx-auto w-[min(40rem,calc(100%-3rem))] max-w-none text-article leading-prose tracking-[-.012em] max-sm:w-[calc(100%-2.25rem)] max-sm:text-base max-sm:leading-prose-mobile',
  '[&_p]:mb-[1.6em] [&_p]:mt-0 [&_p]:!font-sans [&_p]:!text-inherit [&_p]:!text-[inherit] [&_p]:!leading-[inherit]',
  '[&_div]:!font-sans [&_div]:!text-inherit [&_span]:!font-sans [&_span]:!text-inherit [&_a]:!font-sans [&_a]:!text-inherit [&_a]:underline [&_a]:decoration-accent/60 [&_a]:underline-offset-[.18em] hover:[&_a]:!text-accent',
  '[&_h1]:mt-[2.2em] [&_h1]:mb-[.65em] [&_h1]:scroll-mt-17.5 [&_h1]:font-sans [&_h1]:text-prose-h1 [&_h1]:font-medium [&_h1]:leading-none [&_h1]:tracking-heading max-sm:[&_h1]:text-prose-h2',
  '[&_h2]:mt-[3.3em] [&_h2]:mb-[.8em] [&_h2]:border-t [&_h2]:border-line [&_h2]:pt-6.25 [&_h2]:font-sans [&_h2]:text-prose-h2 [&_h2]:font-medium [&_h2]:leading-[1.06] [&_h2]:tracking-heading dark:[&_h2]:border-line-dark max-sm:[&_h2]:text-prose-h2-mobile',
  '[&_h3]:mt-[2.8em] [&_h3]:mb-[.7em] [&_h3]:font-sans [&_h3]:text-prose-h3 [&_h3]:font-medium [&_h3]:leading-[1.12] [&_h3]:tracking-heading max-sm:[&_h3]:text-prose-h3-mobile',
  '[&_h4]:mt-[2.5em] [&_h4]:mb-[.7em] [&_h4]:font-sans [&_h4]:text-prose-h4 [&_h4]:font-medium [&_h4]:tracking-tight-copy',
  '[&_strong]:!font-sans [&_strong]:font-semibold [&_b]:!font-sans [&_b]:font-semibold [&_li]:!font-sans [&_li]:!text-inherit [&_li]:my-[.55em] [&_li]:pl-[.45em] marker:[&_li]:text-accent',
  '[&_ul]:my-[1.8em] [&_ul]:mb-[2.2em] [&_ul]:pl-[1.25em] [&_ol]:my-[1.8em] [&_ol]:mb-[2.2em] [&_ol]:pl-[1.25em]',
  '[&_hr]:mx-auto [&_hr]:my-21.25 [&_hr]:h-px [&_hr]:w-9.5 [&_hr]:border-0 [&_hr]:bg-accent',
  '[&_blockquote]:relative [&_blockquote]:left-1/2 [&_blockquote]:my-[2.5em] [&_blockquote]:mb-[2.7em] [&_blockquote]:w-[min(48.75rem,calc(100vw-3rem))] [&_blockquote]:-translate-x-1/2 [&_blockquote]:border-l [&_blockquote]:border-accent [&_blockquote]:py-3 [&_blockquote]:pl-8.5 [&_blockquote]:font-sans [&_blockquote]:text-[clamp(1.75rem,3.3vw,2.75rem)] [&_blockquote]:font-medium [&_blockquote]:not-italic [&_blockquote]:leading-[1.2] [&_blockquote]:tracking-heading max-sm:[&_blockquote]:w-[calc(100vw-2.25rem)] max-sm:[&_blockquote]:pl-5 max-sm:[&_blockquote]:text-[1.6875rem]',
  '[&_img]:h-auto [&_img]:max-w-full [&_video]:h-auto [&_video]:max-w-full [&_svg]:h-auto [&_svg]:max-w-full [&_.separator]:my-13.75 [&_.separator]:text-center [&_.separator_a]:!m-0 [&_.separator_a]:block [&_.separator_img]:!h-auto [&_.separator_img]:!w-auto [&_.separator_img]:max-w-full',
  '[&_pre]:relative [&_pre]:left-1/2 [&_pre]:my-9.5 [&_pre]:w-[min(57.5rem,calc(100vw-3rem))] [&_pre]:max-w-none [&_pre]:-translate-x-1/2 [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-line [&_pre]:bg-white/70 [&_pre]:px-6 [&_pre]:py-5.5 [&_pre]:text-md [&_pre]:leading-copy [&_pre]:shadow-none dark:[&_pre]:border-line-dark dark:[&_pre]:bg-neutral-950/70 max-sm:[&_pre]:w-[calc(100vw-1.125rem)]',
  '[&_pre_*]:!bg-transparent [&_pre_*]:!font-mono [&_pre_*]:!text-[inherit] [&_pre_*]:!leading-[inherit] [&_:not(pre)>code]:border [&_:not(pre)>code]:border-line [&_:not(pre)>code]:bg-white/60 [&_:not(pre)>code]:px-[.35em] [&_:not(pre)>code]:py-[.16em] [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[.78em] dark:[&_:not(pre)>code]:border-line-dark dark:[&_:not(pre)>code]:bg-neutral-950/60',
  '[&_table]:relative [&_table]:left-1/2 [&_table]:my-11.25 [&_table]:w-[min(57.5rem,calc(100vw-3rem))] [&_table]:max-w-none [&_table]:-translate-x-1/2 [&_table]:border-collapse [&_table]:border [&_table]:border-line [&_table]:text-xs [&_table]:shadow-none dark:[&_table]:border-line-dark max-sm:[&_table]:w-[calc(100vw-1.125rem)] [&_th]:border [&_th]:border-line [&_th]:bg-white/60 [&_th]:p-3 [&_th]:text-left [&_th]:font-semibold dark:[&_th]:border-line-dark dark:[&_th]:bg-neutral-950/60 [&_td]:border [&_td]:border-line [&_td]:p-3 dark:[&_td]:border-line-dark',
  '[&_sup]:text-[.65em] [&_sup]:text-accent [&_.footnotes]:mt-20 [&_.footnotes]:border-t [&_.footnotes]:border-line [&_.footnotes]:pt-7 [&_.footnotes]:text-xs [&_.footnotes]:leading-copy [&_.footnotes]:text-muted dark:[&_.footnotes]:border-line-dark dark:[&_.footnotes]:text-muted-dark',
);
---

<Base head={{ title, description: content.description }}>
  <Navbar active="writing" />

  <main class="overflow-clip py-20 pb-32 max-sm:pt-12">
    <header
      class="mx-auto mb-24 w-[min(57.5rem,calc(100%-3rem))] max-sm:mb-16 max-sm:w-[calc(100%-2.25rem)]"
    >
      <a
        class="mb-12 inline-block text-3xs font-semibold uppercase tracking-nav text-muted no-underline dark:text-muted-dark max-sm:mb-8"
        href="/posts/"
      >
        Writing <b class="text-accent">/</b> Journal entry
      </a>
      <h1
        class="m-0 max-w-4xl text-8xl font-medium tracking-display text-balance"
        transition:name="article-title"
      >
        {articleTitle}
        <i class="not-italic text-accent">.</i>
      </h1>
      <div
        class="mt-12 flex flex-wrap gap-x-8.5 gap-y-3.5 border-t border-line pt-4.5 text-3xs uppercase tracking-wide-label text-muted [font-variant-numeric:tabular-nums] dark:border-line-dark dark:text-muted-dark max-sm:mt-7.5 max-sm:grid max-sm:gap-2"
      >
        <span> Updated {formatDate(updated)}</span>
        <span>{author}</span>
        <span> {content.tags?.join(' · ') || 'Journal'}</span>
      </div>
    </header>

    {
      heroImage && (
        <figure
          class={cn(
            'mx-auto mb-28 max-sm:mb-16',
            heroWidths[content.heroLayout || 'wide'],
          )}
          transition:name="article-hero-image"
        >
          <img
            class="block max-h-[78vh] w-full object-cover"
            src={heroImage}
            alt={content.imgAlt || ''}
          />
          {content.imgAlt && (
            <figcaption class="mt-2.5 text-3xs -tracking-brand text-muted dark:text-muted-dark">
              {content.imgAlt}
            </figcaption>
          )}
        </figure>
      )
    }

    <article id="article-prose" class={prose} transition:animate="fade">
      <slot />
    </article>

    <Comments />

    <footer
      class="mx-auto mt-28 w-[min(57.5rem,calc(100%-3rem))] max-sm:mt-20 max-sm:w-[calc(100%-2.25rem)]"
    >
      <div class="relative h-px bg-line dark:bg-line-dark">
        <i class="absolute -top-0.5 left-0 size-1.5 bg-accent"></i>
      </div>
      <div
        class="grid grid-cols-3 gap-8 py-7.5 pb-16.25 text-md leading-relaxed-copy text-muted dark:text-muted-dark max-sm:block max-sm:pb-9.5 [&_p]:m-0 max-sm:[&_p]:my-2 [&_strong]:font-medium [&_strong]:text-ink dark:[&_strong]:text-ink-dark [&_span]:font-medium [&_span]:text-ink dark:[&_span]:text-ink-dark"
      >
        <p>
          Written by <strong>{author}</strong>
        </p>
        <p>
          Last updated <time
            class="font-medium text-ink [font-variant-numeric:tabular-nums] dark:text-ink-dark"
          >
            {formatDate(updated)}
          </time>
        </p>
        <p>Tags: <span>{content.tags?.join(' · ') || 'Journal'}</span></p>
      </div>
      <nav
        class="grid grid-cols-2 border-y border-line dark:border-line-dark max-sm:block"
        aria-label="Article navigation"
      >
        {
          olderPost ? (
            <a
              class="group flex min-h-32 flex-col justify-between py-7 no-underline max-sm:min-h-28"
              href={publicPostUrl(olderPost)}
            >
              <>
                <span class="text-4xs uppercase tracking-[.14em] text-muted dark:text-muted-dark">
                  Previous article ←
                </span>
                <strong class="text-base font-medium leading-compact tracking-title transition-transform group-hover:translate-x-1">
                  {olderPost.frontmatter.title.trim()}
                </strong>
              </>
            </a>
          ) : (
            <span />
          )
        }
        {
          newerPost ? (
            <a
              class="group flex min-h-32 flex-col justify-between border-l border-line py-7 pl-8.75 text-right no-underline dark:border-line-dark max-sm:min-h-28 max-sm:border-l-0 max-sm:border-t max-sm:pl-0 max-sm:text-left"
              href={publicPostUrl(newerPost)}
            >
              <>
                <span class="text-4xs uppercase tracking-[.14em] text-muted dark:text-muted-dark">
                  Next article →
                </span>
                <strong class="text-base font-medium leading-compact tracking-title transition-transform group-hover:-translate-x-1 max-sm:group-hover:translate-x-1">
                  {newerPost.frontmatter.title.trim()}
                </strong>
              </>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </footer>
  </main>

  <script>
    const updateReadingProgress = () => {
      const progress = document.querySelector<HTMLElement>(
        '[data-reading-progress]',
      );
      const article = document.querySelector<HTMLElement>('#article-prose');
      if (!progress || !article) return;
      const value = Math.max(
        0,
        Math.min(
          1,
          (window.scrollY - article.offsetTop) /
            (article.offsetHeight - window.innerHeight),
        ),
      );
      progress.style.transform = `scaleY(${value})`;
    };
    document.addEventListener('astro:page-load', updateReadingProgress);
    document.addEventListener('scroll', updateReadingProgress, {
      passive: true,
    });
  </script>
</Base>
